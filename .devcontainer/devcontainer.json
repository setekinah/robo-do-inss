{
  "name": "PrevIA",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "PrevIA",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "ROBO_INSS_BIND_HOST": "0.0.0.0",
    "ROBO_INSS_ALLOW_NETWORK": "1",
    "ROBO_INSS_COOKIE_SECURE": "1",
    "ROBO_INSS_DATA_DIR": "/workspaces/.previa-data",
    "PORT": "8000"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt"
}
